# Public site URL (used for canonical URLs, sitemap, OpenGraph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://akansohealth.com

# Contact form email via Resend (server-only).
# If RESEND_API_KEY or CONTACT_FROM_EMAIL is empty, nothing is sent and the
# form shows a phone/email fallback instead.
# Verify the from-domain in Resend first (for example send.akansohealth.com).
# Leave open and click tracking off for that domain. The message is HTML plus
# plain text. Links are tel, mailto, the logo, and the contact page.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Akanso Health Website <website@send.akansohealth.com>"
# Recipients, separated by commas or semicolons. Invalid addresses are ignored.
# Defaults to info@akansohealth.com when empty or when none are valid. At most 50.
CONTACT_TO_EMAIL=intake@akansohealth.com, info@akansohealth.com

# Cloudflare Turnstile. Set both keys to require a check. If either is empty,
# verification is skipped and the form still submits.
# The widget uses action "contact"; the server expects that same action.
# NEXT_PUBLIC_ vars are inlined at build time — redeploy after changing the site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional comma-separated hostnames. When set, siteverify must return one of
# them. Leave this empty on Preview, where the hostname changes per deployment.
# Do not list localhost on Production.
# TURNSTILE_HOSTNAMES=akansohealth.com,www.akansohealth.com

# Optional: link to an existing Jotform intake form (shown on /contact when set)
NEXT_PUBLIC_JOTFORM_URL=

# Optional: Jotform application form embedded on /careers (shows a "coming soon" card with phone/email when empty)
NEXT_PUBLIC_JOTFORM_CAREERS_URL=

# Optional: Google Analytics 4 measurement ID (loads gtag only when set)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
