# Public site URL (used for canonical URLs, sitemap, OpenGraph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.akansohhealthservices.com

# Contact form forwarding (server-only). The /api/contact route POSTs JSON here.
# Works with FormSubmit (https://formsubmit.co/ajax/<inbox>), Formspree, Make/Zapier/n8n webhooks, etc.
# Leave empty to show the phone/email fallback instead of submitting.
CONTACT_FORM_ENDPOINT=
# Optional bearer token sent as Authorization header to the endpoint above
CONTACT_FORM_TOKEN=

# Optional: link to an existing Jotform intake form (shown on /contact when set)
NEXT_PUBLIC_JOTFORM_URL=

# Optional: Jotform application form embedded on /careers (shows a "coming soon" card with phone/email when empty)
NEXT_PUBLIC_JOTFORM_CAREERS_URL=

# Optional: Google Analytics 4 measurement ID (loads gtag only when set)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
